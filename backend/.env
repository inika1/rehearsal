# Supabase (server-side only — service role key bypasses RLS, never expose to frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (optional — without it the app falls back to canned replies + heuristic analysis)
ANTHROPIC_API_KEY=

# CORS: the deployed frontend origin, e.g. https://rehearsal.vercel.app
FRONTEND_ORIGIN=

# Port (Railway sets this automatically)
PORT=4000
