# Supabase (server-side only — service role key bypasses RLS, never expose to frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (optional — without it the app falls back to canned replies + heuristic analysis)
ANTHROPIC_API_KEY=

# ElevenLabs voice synthesis for coach replies
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# CORS: the deployed frontend origin, e.g. https://bridge.vercel.app
FRONTEND_ORIGIN=

# Port (Railway sets this automatically)
PORT=4000
