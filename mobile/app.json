{
  "expo": {
    "name": "Bridge",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anshigoyal.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Bridge uses your microphone so your coach can hear you during prep sessions.",
        "NSSpeechRecognitionUsageDescription": "Bridge transcribes your speech so you can prepare for difficult conversations hands-free."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anshigoyal.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c1b4861c-8369-4c21-b870-ef021c50b7ea"
      }
    },
    "plugins": [
      "expo-speech-recognition"
    ]
  }
}
